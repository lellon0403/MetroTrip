# 애플리케이션 기본 설정: 서비스명, 실행 환경, 디버그, API 경로
METROTRIP_APP_NAME=MetroTrip API
METROTRIP_APP_ENV=production
METROTRIP_DEBUG=false
METROTRIP_API_V1_PREFIX=/api/v1

# 프론트엔드 연동: 서비스 도메인의 CORS 허용 출처와 기준 URL
METROTRIP_CORS_ORIGINS=["https://metrotrip.kro.kr"]
METROTRIP_PUBLIC_FRONTEND_URL=https://metrotrip.kro.kr

# 기본 MySQL 연결: 데이터베이스 URL과 컨테이너에 마운트한 TLS CA 인증서
METROTRIP_DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
METROTRIP_SSL_CA_PATH=/run/certs/mysql/ca.pem

# 인증 및 토큰: JWT 비밀키, 토큰·공유 링크·인증 코드 만료 정책
METROTRIP_JWT_SECRET=<random-secret-at-least-32-characters>
METROTRIP_ACCESS_TOKEN_EXPIRE_MINUTES=30
METROTRIP_REFRESH_TOKEN_EXPIRE_DAYS=14
METROTRIP_SHARE_LINK_EXPIRE_DAYS=7
METROTRIP_VERIFICATION_CODE_EXPIRE_MINUTES=5
METROTRIP_VERIFICATION_MAX_ATTEMPTS=5

# 이메일 발송: 콘솔 또는 SMTP 모드와 SMTP 서버 인증 설정
METROTRIP_EMAIL_MODE=console
METROTRIP_SMTP_HOST=
METROTRIP_SMTP_PORT=587
METROTRIP_SMTP_USERNAME=
METROTRIP_SMTP_PASSWORD=
METROTRIP_SMTP_FROM=
METROTRIP_SMTP_USE_TLS=true

# 업로드 미디어: Docker volume의 저장 경로와 업로드 URL 만료 시간
METROTRIP_MEDIA_ROOT_DIR=/app/media
METROTRIP_MEDIA_UPLOAD_EXPIRE_MINUTES=15

# Oracle 폴백 및 동기화: 연결·wallet·장애조치·동기화 정책
METROTRIP_ORACLE_RO_URL=oracle+oracledb://<ro-user>:<password>@<tns-alias>
METROTRIP_ORACLE_SYNC_URL=oracle+oracledb://<sync-user>:<password>@<tns-alias>
METROTRIP_ORACLE_WALLET_DIR=/run/certs/oracle
METROTRIP_ORACLE_WALLET_PASSWORD=<wallet-password>
METROTRIP_FAILOVER_CACHE_SECONDS=5
METROTRIP_FAILOVER_FAIL_THRESHOLD=2
METROTRIP_FAILOVER_RECOVER_THRESHOLD=2
METROTRIP_SYNC_INTERVAL_MINUTES=10
METROTRIP_SYNC_EXCLUDE_TABLES=[]
