# docker-compose.yml용 배포 환경변수 초안. 배포 서버에서 이 파일을 .env로 복사해 채운다.
# (이 파일 자체는 예시일 뿐 커밋해도 되지만, 실제 값이 든 .env는 .gitignore로 막혀 있다.)
#
# - DOCKERHUB_NAMESPACE      : docker-compose.yml의 `image:`가 pull할 Docker Hub
#                              네임스페이스. .github/workflows/cd-main.yml이 push하는
#                              태그(<네임스페이스>/metrotrip-backend 등)와 반드시 같아야
#                              한다 — 저장소 Variables의 DOCKERHUB_NAMESPACE와 같은 값.
# - METROTRIP_*              : api 컨테이너에 env_file로 그대로 전달된다 (backend/app/config.py 참고).
# - NEXT_PUBLIC_KAKAO_JS_KEY : **여기 채워도 서버 배포에는 반영 안 된다.** frontend 이미지는
#                              이미 cd-main.yml이 빌드 시점에 이 값을 번들에 박아서
#                              Docker Hub에 올린 상태다 — 로컬에서 `docker compose up -d
#                              --build`로 직접 빌드/검증할 때만 쓰인다(docs/CICD.md 4장).
# - API_INTERNAL_BASE_URL    : frontend 컨테이너가 next.config.ts의 /api/v1 프록시로
#                              api 서비스를 찾을 때 쓴다. docker-compose.yml에서 이미
#                              `http://api:8000`으로 고정해뒀으니 보통 안 건드려도 된다.

# ── docker-compose.yml의 image: 태그 (배포 서버 전용) ──
DOCKERHUB_NAMESPACE=<Docker Hub 네임스페이스>

# ── backend/api (backend/app/config.py의 METROTRIP_ 접두사 설정) ──
METROTRIP_APP_NAME=MetroTrip API
METROTRIP_APP_ENV=production
METROTRIP_DEBUG=false
METROTRIP_API_V1_PREFIX=/api/v1

# 외부 PC/클라우드에 구축한 MySQL을 가리킨다 (이 compose는 DB 컨테이너를 안 띄운다).
# 개발 기간엔 Aiven을 쓴다 (backend/.env.example 참고).
METROTRIP_DATABASE_URL=mysql+pymysql://<사용자>:<비밀번호>@<외부 DB 호스트>:3306/metrotrip?charset=utf8mb4
# 외부 MySQL이 SSL 인증서를 요구할 때만 채운다. backend/certs/ca.pem을 배포 서버에
# 미리 올려두고, docker-compose.yml의 api.volumes 마운트 경로와 맞춘다.
METROTRIP_SSL_CA_PATH=

# 실제 배포 주소 (2026-08-12 확정)
METROTRIP_CORS_ORIGINS=["https://metrotrip.kro.kr"]
METROTRIP_JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
METROTRIP_ACCESS_TOKEN_EXPIRE_MINUTES=30
METROTRIP_REFRESH_TOKEN_EXPIRE_DAYS=14
METROTRIP_PUBLIC_FRONTEND_URL=https://metrotrip.kro.kr
METROTRIP_SHARE_LINK_EXPIRE_DAYS=7
METROTRIP_VERIFICATION_CODE_EXPIRE_MINUTES=5
METROTRIP_VERIFICATION_MAX_ATTEMPTS=5
METROTRIP_EMAIL_MODE=console
METROTRIP_SMTP_HOST=
METROTRIP_SMTP_PORT=587
METROTRIP_SMTP_USERNAME=
METROTRIP_SMTP_PASSWORD=
METROTRIP_SMTP_FROM=
METROTRIP_SMTP_USE_TLS=true

# DB 이중화 (docs/DB-FAILOVER.md) — MySQL 장애 시 조회를 Oracle로 폴백한다.
# 아직 실제 Oracle 인스턴스가 없어 비워둬도 앱은 정상 기동한다(전부 Optional).
METROTRIP_ORACLE_RO_URL=
METROTRIP_ORACLE_SYNC_URL=
METROTRIP_FAILOVER_CACHE_SECONDS=5
METROTRIP_FAILOVER_FAIL_THRESHOLD=2
METROTRIP_FAILOVER_RECOVER_THRESHOLD=2
METROTRIP_SYNC_INTERVAL_MINUTES=10
# 지갑(wallet) 디렉터리도 certs처럼 배포 서버에 직접 올리고 볼륨 마운트가 필요하다.
# docker-compose.yml에는 아직 마운트를 안 추가했다 — 지갑이 준비되면 같이 추가할 것.
METROTRIP_ORACLE_WALLET_DIR=
METROTRIP_ORACLE_WALLET_PASSWORD=

# ── frontend (Next.js, build.args로 전달 — frontend/Dockerfile 참고) ──
NEXT_PUBLIC_KAKAO_JS_KEY=여기에_JavaScript_키
