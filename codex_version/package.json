{
  "name": "metrotrip-codex-version",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @metrotrip/web",
    "dev:mobile": "npm run start --workspace @metrotrip/mobile",
    "build:web": "npm run build --workspace @metrotrip/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/unit-foundations.test.mjs",
    "contracts:generate": "npm run generate --workspace @metrotrip/contracts",
    "verify:web-flow": "node scripts/verify-web-flow.mjs",
    "verify:product-journey": "node scripts/verify-product-journey.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:web"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "lucide-react": "^1.31.0"
  }
}
